<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sil_carla_bridge</name>
  <version>0.1.0</version>
  <description>
    CARLA integration hooks for the SIL AEB stack. Converts CARLA ground truth
    into ROS 2 PointXYZI sweeps and camera detections, and provides a
    deterministic ray-casting LiDAR synthesiser so the pipeline can be exercised
    without a simulator.
  </description>
  <maintainer email="sil-aeb@example.com">SIL AEB Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>eigen</depend>
  <depend>sil_interfaces</depend>

  <exec_depend>carla_ros_bridge</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
