<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sil_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level launch files that bring up the whole SIL AEB stack: CARLA bridge,
    sensor fusion, AEB controller and CAN gateway.
  </description>
  <maintainer email="sil-aeb@example.com">SIL AEB Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>sil_carla_bridge</exec_depend>
  <exec_depend>sil_sensor_fusion</exec_depend>
  <exec_depend>sil_aeb_controller</exec_depend>
  <exec_depend>sil_can_gateway</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
