<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sil_can_gateway</name>
  <version>0.1.0</version>
  <description>
    Linux SocketCAN gateway for the SIL AEB stack. Serialises brake commands and
    target vehicle speed into classic 8-byte CAN frames (with CRC-8/SAE-J1850
    and a rolling counter) and transmits them on a virtual interface such as
    vcan0.
  </description>
  <maintainer email="sil-aeb@example.com">SIL AEB Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sil_interfaces</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
